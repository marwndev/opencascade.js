{
  "name": "ocjs-fluidcad",
  "version": "1.8.0",
  "description": "Custom build of OC.js for FluidCAD",
  "keywords": [
    "opencascade",
    "occt",
    "cad",
    "wasm",
    "webassembly",
    "brep",
    "step",
    "iges",
    "geometry",
    "3d"
  ],
  "homepage": "https://github.com/Fluid-CAD/FluidCAD",
  "license": "LGPL-2.1-only WITH Open-CASCADE-Exception-1.0",
  "author": "Marwan Aouida",
  "contributors": [
    {
      "name": "Sebastian Alff",
      "email": "donalffons@gmail.com"
    }
  ],
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./wasm": "./dist/opencascade.fluidcad.multi-threaded.wasm"
  },
  "files": [
    "dist/index.js",
    "dist/index.d.ts",
    "dist/aliases.generated.js",
    "dist/aliases.generated.json",
    "dist/opencascade.fluidcad.multi-threaded.js",
    "dist/opencascade.fluidcad.multi-threaded.wasm",
    "dist/opencascade.fluidcad.multi-threaded.d.ts",
    "dist/opencascade.fluidcad.multi-threaded.js.symbols",
    "dist/opencascade.fluidcad.multi-threaded.build-manifest.json",
    "dist/opencascade.fluidcad.multi-threaded.provenance.json"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "release:prepare": "node scripts/prepare-release.mjs",
    "build:toolchain": "npm run build --workspace=@libcascade/toolchain",
    "generate:toolchain": "node packages/toolchain/scripts/generate-toolchain.mjs",
    "generate:brand": "node scripts/generate-logo.mjs && node scripts/generate-banner.mjs",
    "generate:brand:check": "node scripts/generate-logo.mjs --check && node scripts/generate-banner.mjs --check",
    "test": "vitest run",
    "test:ci": "CI=true vitest run tests/ci tests/readme-shape.test.ts tests/docs-layout.test.ts starter-templates/*/tests",
    "test:smoke": "vitest run tests/smoke/",
    "test:regression": "vitest run --config vitest.regression.config.ts",
    "test:docker": "vitest run --config vitest.docker.config.ts",
    "test:package": "vitest run --config vitest.package.config.ts",
    "test:toolchain": "npm test --workspace=@libcascade/toolchain",
    "typecheck": "tsc --project tests/tsconfig.json",
    "typecheck:toolchain": "tsc --project packages/toolchain/tsconfig.json",
    "lint": "eslint --config eslint.config.mjs .",
    "lint:fix": "eslint --config eslint.config.mjs --fix .",
    "test:fluidcad-checks": "node scripts/check-fluidcad-self-interference.mjs && tsc --noEmit --skipLibCheck --module NodeNext --target ES2022 scripts/check-fluidcad-self-interference.types.ts",
    "test:fluidcad-sweep-topology": "node scripts/check-fluidcad-sweep-topology.mjs && tsc --noEmit --skipLibCheck --module NodeNext --target ES2022 scripts/check-fluidcad-sweep-topology.types.ts"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.3.0",
    "@gltf-transform/functions": "^4.3.0",
    "@nx/js": "22.5.2",
    "@types/node": "~24.0.15",
    "eslint": "^9.32.0",
    "nx": "22.5.2",
    "semver": "^7.7.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1",
    "vitest": "^4.1.0",
    "yaml": "^2.8.2"
  }
}
